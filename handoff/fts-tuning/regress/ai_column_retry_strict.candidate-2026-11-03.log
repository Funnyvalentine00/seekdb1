drop database if exists ai_column_retry_strict;
create database ai_column_retry_strict;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('retry_strict_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('retry_strict_model');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('retry_strict_model',
'{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('retry_strict_ep',
'{"ai_model_name":"retry_strict_model","url":"http://127.0.0.1:19124/v1/chat/completions","access_key":"retry-key","provider":"openai","request_model_name":"mock-complete"}');
create table ai_column_retry_strict.docs(
id bigint primary key,
category varchar(20),
status varchar(20),
content varchar(200),
result varchar(400) AI COLUMN (
AI_COMPLETE('retry_strict_model', content)
) WITH (sync_mode='async', max_retries=0),
label varchar(400) AI COLUMN (
AI_COMPLETE('retry_strict_model', concat('Label: ', content))
) WITH (sync_mode='async', max_retries=0)
);
insert into ai_column_retry_strict.docs(id, category, status, content)
values (1, 'news', 'active', 'row-one'),
(2, 'sports', 'active', 'row-two'),
(3, 'news', 'inactive', 'row-three');
select 1 = 1 as initial_results_ready;
initial_results_ready
1
select @@ai_column_strict_read as strict_read_defaults_off;
strict_read_defaults_off
0
alter table ai_column_retry_strict.docs
retry ai column result where id in (1, 3);
set session ai_column_strict_read = off;
select id,
result is null as selected_result_invalidated,
label is not null as other_ai_column_unchanged
from ai_column_retry_strict.docs order by id;
id	selected_result_invalidated	other_ai_column_unchanged
1	1	1
2	0	1
3	1	1
set session ai_column_strict_read = on;
select id, category from ai_column_retry_strict.docs order by id;
id	category
1	news
2	sports
3	news
