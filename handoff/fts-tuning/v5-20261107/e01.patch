+namespace
+{
+class WordCountUpdater
+{
+public:
+  WordCountUpdater(const int64_t word_freq, const ObFTWord &word)
+    : word_freq_(word_freq), word_(word) {}
+
+  int operator()(common::hash::HashMapPair<ObFTWord, int64_t> &entry) const
+  {
+    // Overwrite the key as set_refactored(..., overwrite=1) did: the last
+    // spelling of a collation-equal word is part of TOKENIZE's output.
+    entry.first = word_;
+    entry.second += word_freq_;
+    return OB_SUCCESS;
+  }
+
+private:
+  int64_t word_freq_;
+  const ObFTWord &word_;
+};
+} // namespace
