--echo batch1_ends
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 1) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket IN (10,30) ORDER BY id;
--echo batch1_none
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 1) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket=99 ORDER BY id;
