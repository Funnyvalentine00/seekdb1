UPDATE noscore_lookup_filter SET bucket=20 WHERE id=4;
DELETE FROM noscore_lookup_filter WHERE id=2;
--echo after_dml
SELECT id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket=20 ORDER BY id;
