SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 16) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket=20 ORDER BY id;
