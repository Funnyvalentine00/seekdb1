--disable_query_log
SET NAMES utf8mb4;
SET SESSION ob_enable_plan_cache=0;
CREATE TABLE noscore_lookup_filter (
  id BIGINT PRIMARY KEY,
  title VARCHAR(128),
  body VARCHAR(256),
  bucket INT,
  FULLTEXT INDEX ft(title, body) WITH PARSER space
);
INSERT INTO noscore_lookup_filter VALUES
  (1, 'qalpha', 'qbeta', 10),
  (2, 'qalpha qalpha', 'qgamma', 20),
  (3, 'qdelta', 'qbeta', 20),
  (4, 'qgamma', 'qdelta', 30),
  (5, 'qunrelated', 'qother', 40),
  (6, '', '', 10),
  (7, 'qlambda', 'qalpha', 20),
  (8, NULL, NULL, 20),
  (9, '全文', '稳定 database', 40);

INSERT INTO noscore_lookup_filter VALUES (10,'qalpha','',NULL);
--echo batch0_middle
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 0) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket=20 ORDER BY id;
--echo batch0_last
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 0) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket=30 ORDER BY id;
--echo batch0_null
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 0) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket IS NULL ORDER BY id;
--echo batch0_ends
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 0) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket IN (10,30) ORDER BY id;
--echo batch0_none
SELECT /*+ OPT_PARAM('ROWSETS_MAX_ROWS', 0) */ id,bucket,title FROM noscore_lookup_filter WHERE MATCH(title,body) AGAINST('qalpha qbeta qgamma') AND bucket=99 ORDER BY id;
