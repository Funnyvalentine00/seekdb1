+// Dispatch the whole scan once so the distance calculation can stay inlined.
+// Its accumulation and reduction order remains shared with l2DistanceAvx2.
+__attribute__((target("avx2,fma")))
+void scanTopKAvx2(const uint8_t *base, uint32_t slot_count, uint32_t slot_size,
+                 uint32_t vec_off, int dim, const float *query, size_t k,
+                 std::vector<TopKEntry> &heap) {
+  for (uint32_t s = 0; s < slot_count; ++s) {
+    const uint8_t *p = base + static_cast<size_t>(s) * slot_size;
+    if (p[0] == 0) continue;
+    int64_t id;
+    std::memcpy(&id, p + 8, sizeof(id));
+    float d = l2DistanceAvx2Impl(reinterpret_cast<const float *>(p + vec_off), query,
+                                static_cast<size_t>(dim));
+    // Most rows lose once the heap is full. Reject them before an out-of-line
+    // heap update can force an AVX/SSE transition and spill the scan state.
+    if (heap.size() == k) {
+      const TopKEntry &worst = heap.front();
+      if (!(d < worst.dist || (d == worst.dist && id < worst.id))) continue;
+    }
+    heapPush(heap, k, TopKEntry{d, id, s});
+  }
+}
