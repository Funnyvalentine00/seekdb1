+  // 从已提交的主键索引选出有序前缀，只保留 limit 个键和槽号。
+  std::vector<std::pair<int64_t, uint32_t>> orderedPrimaryKeys(size_t limit, bool desc) const {
+    std::vector<std::pair<int64_t, uint32_t>> result(std::min(limit, rowCount()));
+    const auto before = [desc](const auto &a, const auto &b) {
+      return desc ? a.first > b.first : a.first < b.first;
+    };
+    std::partial_sort_copy(id_to_slot_.begin(), id_to_slot_.end(),
+                           result.begin(), result.end(), before);
+    return result;
   }
 
