BEGIN;
UPDATE t SET id = 3 WHERE payload = 'first';
UPDATE t SET id = 1 WHERE payload = 'second';
UPDATE t SET id = 2 WHERE payload = 'first';
COMMIT;
SELECT id, payload FROM t ORDER BY id;
SELECT id, payload FROM t WHERE id = 1;
SELECT id, payload FROM t WHERE id = 2;
