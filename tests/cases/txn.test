CREATE TABLE t (id BIGINT PRIMARY KEY, v VARCHAR(8), vec VECTOR(2));
INSERT INTO t VALUES (1, 'a', '[0, 0]');
BEGIN;
INSERT INTO t VALUES (2, 'b', '[1, 0]');
SELECT id, v FROM t ORDER BY id;
UPDATE t SET v = 'aa' WHERE id = 1;
SELECT id, v FROM t ORDER BY id;
SELECT id, L2_DISTANCE(vec, '[0,0]') AS d FROM t ORDER BY d LIMIT 5;
ROLLBACK;
SELECT id, v FROM t ORDER BY id;
COMMIT;
BEGIN;
