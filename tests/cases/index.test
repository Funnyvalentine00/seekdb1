CREATE TABLE idx_t (id BIGINT PRIMARY KEY, v VECTOR(2));
INSERT INTO idx_t VALUES (1, '[0,0]'), (2, '[1,0]'), (3, '[0,2]');
CREATE VECTOR INDEX vidx ON idx_t(v);
SELECT id, L2_DISTANCE(v, '[0,0]') AS d FROM idx_t ORDER BY d LIMIT 3;
CREATE VECTOR INDEX vidx ON idx_t(v);
INSERT INTO idx_t VALUES (4, '[0.5,0]');
UPDATE idx_t SET v = '[2,0]' WHERE id = 2;
DELETE FROM idx_t WHERE id = 3;
SELECT id, L2_DISTANCE(v, '[0,0]') AS d FROM idx_t ORDER BY d LIMIT 10;
DROP INDEX vidx ON idx_t;
DROP INDEX vidx ON idx_t;
