CREATE TABLE e (id BIGINT PRIMARY KEY, s VARCHAR(2), v VECTOR(2));
INSERT INTO e VALUES (-1, '中', '[0,0]'), (0, 'a', '[3,4]'), (2, '乙', '[0,1]');
SELECT id, s FROM e ORDER BY s;
SELECT id, L2_DISTANCE(v, '[0,0]') AS d FROM e ORDER BY d LIMIT 2;
SELECT * FROM e ORDER BY id;
SELECT id FROM e ORDER BY id LIMIT 0;
SELECT id FROM e ORDER BY id LIMIT 100;
SELECT id, s FROM e ORDER BY s DESC, id DESC;
UPDATE e SET id = 5 WHERE id = 0;
SELECT id FROM e ORDER BY id;
UPDATE e SET id = 2 WHERE id = 5;
SELECT id, s FROM e WHERE id = -1;
BEGIN;
INSERT INTO e VALUES (1, 'x', '[1,1]');
INSERT INTO e VALUES (1, 'y', '[2,2]');
SELECT id FROM e ORDER BY id;
COMMIT;
SELECT id FROM e ORDER BY id;
DELETE FROM e;
SELECT id FROM e;
INSERT INTO e VALUES (7, 'z', '[0,0]'), (10, 'q', '[1,0]'), (11, 'r', '[0,1]');
SELECT id, L2_DISTANCE(v, '[0,0]') AS d FROM e ORDER BY d LIMIT 5;
INSERT INTO e VALUES (12, 'ab', '[0,0]');
INSERT INTO e VALUES (13, 'abc', '[0,0]');
SELECT id, s FROM e ORDER BY id;
