CREATE TABLE a (id BIGINT PRIMARY KEY, x VARCHAR(4));
CREATE TABLE b (id BIGINT PRIMARY KEY, y BIGINT);
BEGIN;
INSERT INTO a VALUES (1, 'a');
INSERT INTO b VALUES (1, 10);
ROLLBACK;
SELECT id FROM a;
SELECT id FROM b;
BEGIN;
INSERT INTO a VALUES (2, 'b');
INSERT INTO b VALUES (2, 20);
COMMIT;
SELECT id, x FROM a ORDER BY id;
SELECT id, y FROM b ORDER BY id;
