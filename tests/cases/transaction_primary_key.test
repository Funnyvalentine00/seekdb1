CREATE TABLE t (payload VARCHAR(12), id BIGINT PRIMARY KEY);
INSERT INTO t VALUES ('base', 1), ('other', 4);
BEGIN;
UPDATE t SET id = 2 WHERE id = 1;
SELECT id, payload FROM t WHERE id = 1;
SELECT id, payload FROM t WHERE 2 = id;
DELETE FROM t WHERE id = 1;
INSERT INTO t VALUES ('duplicate', 2);
INSERT INTO t VALUES ('reused', 1);
SELECT id, payload FROM t WHERE id = 1;
UPDATE t SET payload = 'moved' WHERE id = 2;
SELECT id, payload FROM t WHERE id = 2;
DELETE FROM t WHERE id = 2;
SELECT id, payload FROM t WHERE id = 2;
ROLLBACK;
SELECT id, payload FROM t ORDER BY id;
BEGIN;
UPDATE t SET id = 2 WHERE id = 1;
INSERT INTO t VALUES ('reused', 1);
COMMIT;
SELECT id, payload FROM t WHERE id = 1;
SELECT id, payload FROM t WHERE id = 2;
# kill
SELECT id, payload FROM t WHERE id = 1;
SELECT id, payload FROM t WHERE id = 2;
BEGIN;
INSERT INTO t VALUES ('new', 6);
UPDATE t SET id = 7 WHERE id = 6;
SELECT id, payload FROM t WHERE id = 6;
SELECT id, payload FROM t WHERE id = 7;
ROLLBACK;
SELECT id, payload FROM t WHERE id = 7;
